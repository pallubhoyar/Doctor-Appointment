import javax.swing.*;
import javax.swing.table.DefaultTableModel;
import java.awt.*;
import java.io.*;
import java.time.LocalDate;
import java.time.format.DateTimeParseException;
import java.util.ArrayList;
import java.util.List;

public class DoctorAppointmentBookingSystem extends JFrame {
    private static final String DATA_FILE = "appointments.txt";
    private final JTextField patient = new JTextField(16);
    private final JTextField age = new JTextField(5);
    private final JTextField phone = new JTextField(12);
    private final JTextField problem = new JTextField(16);
    private final JComboBox<String> doctor = new JComboBox<>(new String[] {
        "Dr. Sharma - General Physician", "Dr. Patel - Dentist",
        "Dr. Khan - Dermatologist", "Dr. Joshi - Pediatrician"
    });
    private final JTextField date = new JTextField(LocalDate.now().plusDays(1).toString(), 10);
    private final JComboBox<String> time = new JComboBox<>(new String[] {
        "09:00", "09:30", "10:00", "10:30", "11:00", "11:30",
        "12:00", "14:00", "14:30", "15:00", "15:30", "16:00"
    });
    private final DefaultTableModel model = new DefaultTableModel(
        new String[] {"ID", "Patient", "Age", "Phone", "Problem", "Doctor", "Date", "Time", "Status"}, 0) {
        public boolean isCellEditable(int r, int c) { return false; }
    };
    private final JTable table = new JTable(model);
    private final JTextField search = new JTextField(14);
    private final List<Appointment> appointments = new ArrayList<>();
    private int nextId = 1;

    public DoctorAppointmentBookingSystem() {
        super("Doctor Appointment Booking System");
        setDefaultCloseOperation(JFrame.EXIT_ON_CLOSE);
        setSize(1150, 650);
        setLocationRelativeTo(null);
        setLayout(new BorderLayout(8, 8));

        JLabel title = new JLabel("DOCTOR APPOINTMENT BOOKING SYSTEM", SwingConstants.CENTER);
        title.setFont(new Font("SansSerif", Font.BOLD, 22));
        title.setBorder(BorderFactory.createEmptyBorder(14, 8, 8, 8));
        add(title, BorderLayout.NORTH);

        JPanel form = new JPanel(new GridBagLayout());
        form.setBorder(BorderFactory.createTitledBorder("Book New Appointment"));
        GridBagConstraints g = new GridBagConstraints();
        g.insets = new Insets(6, 6, 6, 6);
        g.anchor = GridBagConstraints.WEST;
        g.fill = GridBagConstraints.HORIZONTAL;
        addRow(form, g, 0, "Patient name:", patient);
        addRow(form, g, 1, "Age:", age);
        addRow(form, g, 2, "Phone (10 digits):", phone);
        addRow(form, g, 3, "Problem / reason:", problem);
        addRow(form, g, 4, "Doctor:", doctor);
        addRow(form, g, 5, "Date (YYYY-MM-DD):", date);
        addRow(form, g, 6, "Time:", time);

        JButton book = new JButton("Book Appointment");
        JButton clear = new JButton("Clear Form");
        JButton cancel = new JButton("Cancel Selected");
        JButton all = new JButton("Show All");
        JPanel actions = new JPanel(new GridLayout(0, 1, 4, 4));
        actions.add(book); actions.add(clear); actions.add(cancel); actions.add(all);
        g.gridx = 0; g.gridy = 7; g.gridwidth = 2; g.weightx = 1;
        form.add(actions, g);

        JPanel right = new JPanel(new BorderLayout(6, 6));
        right.setBorder(BorderFactory.createTitledBorder("Appointments"));
        JPanel searchPanel = new JPanel(new FlowLayout(FlowLayout.LEFT));
        searchPanel.add(new JLabel("Search by patient / ID / phone:"));
        searchPanel.add(search);
        JButton find = new JButton("Search");
        searchPanel.add(find);
        right.add(searchPanel, BorderLayout.NORTH);
        table.setAutoCreateRowSorter(true);
        table.setSelectionMode(ListSelectionModel.SINGLE_SELECTION);
        table.setRowHeight(23);
        right.add(new JScrollPane(table), BorderLayout.CENTER);

        JPanel center = new JPanel(new BorderLayout(8, 8));
        center.setBorder(BorderFactory.createEmptyBorder(0, 10, 10, 10));
        center.add(form, BorderLayout.WEST);
        center.add(right, BorderLayout.CENTER);
        add(center, BorderLayout.CENTER);
        add(new JLabel("Local demo application — records are saved in appointments.txt", SwingConstants.CENTER),
            BorderLayout.SOUTH);

        book.addActionListener(e -> bookAppointment());
        clear.addActionListener(e -> clearForm());
        cancel.addActionListener(e -> cancelAppointment());
        all.addActionListener(e -> refresh(appointments));
        find.addActionListener(e -> searchAppointments());

        loadAppointments();
        refresh(appointments);
    }

    private void addRow(JPanel p, GridBagConstraints g, int row, String label, Component input) {
        g.gridx = 0; g.gridy = row; g.gridwidth = 1; g.weightx = 0;
        p.add(new JLabel(label), g);
        g.gridx = 1; g.weightx = 1;
        p.add(input, g);
    }

    private void bookAppointment() {
        String name = patient.getText().trim();
        String ageText = age.getText().trim();
        String phoneText = phone.getText().trim();
        String reason = problem.getText().trim();
        String selectedDoctor = (String) doctor.getSelectedItem();
        String dateText = date.getText().trim();
        String selectedTime = (String) time.getSelectedItem();

        if (name.isEmpty() || ageText.isEmpty() || phoneText.isEmpty() || reason.isEmpty()) {
            message("Please fill in all patient details.", "Missing Details", JOptionPane.WARNING_MESSAGE);
            return;
        }
        int years;
        try {
            years = Integer.parseInt(ageText);
            if (years < 1 || years > 120) throw new NumberFormatException();
        } catch (NumberFormatException ex) {
            message("Enter a valid age between 1 and 120.", "Invalid Age", JOptionPane.WARNING_MESSAGE);
            return;
        }
        if (!phoneText.matches("[0-9]{10}")) {
            message("Enter a 10-digit phone number.", "Invalid Phone", JOptionPane.WARNING_MESSAGE);
            return;
        }
        LocalDate parsedDate;
        try {
            parsedDate = LocalDate.parse(dateText);
        } catch (DateTimeParseException ex) {
            message("Use date format YYYY-MM-DD, for example 2026-10-20.", "Invalid Date", JOptionPane.WARNING_MESSAGE);
            return;
        }
        if (parsedDate.isBefore(LocalDate.now())) {
            message("Appointment date cannot be in the past.", "Invalid Date", JOptionPane.WARNING_MESSAGE);
            return;
        }
        for (Appointment a : appointments) {
            if (a.status.equals("Booked") && a.doctor.equals(selectedDoctor)
                && a.date.equals(dateText) && a.time.equals(selectedTime)) {
                message("That doctor already has a booking at this date and time. Choose another slot.",
                    "Slot Unavailable", JOptionPane.WARNING_MESSAGE);
                return;
            }
        }

        Appointment a = new Appointment(nextId++, name, years, phoneText, reason,
            selectedDoctor, dateText, selectedTime, "Booked");
        appointments.add(a);
        if (saveAppointments()) {
            refresh(appointments);
            clearForm();
            message("Appointment booked successfully! Appointment ID: " + a.id,
                "Success", JOptionPane.INFORMATION_MESSAGE);
        } else {
            appointments.remove(a);
            nextId--;
        }
    }

    private void cancelAppointment() {
        int viewRow = table.getSelectedRow();
        if (viewRow < 0) {
            message("Select an appointment from the table first.", "No Selection", JOptionPane.WARNING_MESSAGE);
            return;
        }
        int row = table.convertRowIndexToModel(viewRow);
        int id = Integer.parseInt(String.valueOf(model.getValueAt(row, 0)));
        Appointment a = findById(id);
        if (a == null || !a.status.equals("Booked")) {
            message("This appointment is already cancelled.", "Cannot Cancel", JOptionPane.WARNING_MESSAGE);
            return;
        }
        int answer = JOptionPane.showConfirmDialog(this,
            "Cancel appointment ID " + a.id + " for " + a.patient + "?",
            "Confirm Cancellation", JOptionPane.YES_NO_OPTION);
        if (answer == JOptionPane.YES_OPTION) {
            a.status = "Cancelled";
            if (saveAppointments()) {
                refresh(appointments);
                message("Appointment cancelled.", "Cancelled", JOptionPane.INFORMATION_MESSAGE);
            } else {
                a.status = "Booked";
            }
        }
    }

    private void searchAppointments() {
        String q = search.getText().trim().toLowerCase();
        if (q.isEmpty()) { refresh(appointments); return; }
        List<Appointment> result = new ArrayList<>();
        for (Appointment a : appointments) {
            if (String.valueOf(a.id).contains(q) || a.patient.toLowerCase().contains(q)
                || a.phone.contains(q)) result.add(a);
        }
        refresh(result);
    }

    private void refresh(List<Appointment> list) {
        model.setRowCount(0);
        for (Appointment a : list) {
            model.addRow(new Object[] {a.id, a.patient, a.age, a.phone, a.problem,
                a.doctor, a.date, a.time, a.status});
        }
    }

    private void clearForm() {
        patient.setText(""); age.setText(""); phone.setText(""); problem.setText("");
        date.setText(LocalDate.now().plusDays(1).toString());
        doctor.setSelectedIndex(0); time.setSelectedIndex(0); patient.requestFocus();
    }

    private void loadAppointments() {
        File file = new File(DATA_FILE);
        if (!file.exists()) return;
        try (BufferedReader in = new BufferedReader(new FileReader(file))) {
            String line;
            while ((line = in.readLine()) != null) {
                String[] p = line.split("\\t", -1);
                if (p.length != 9) continue;
                try {
                    Appointment a = new Appointment(Integer.parseInt(p[0]), decode(p[1]),
                        Integer.parseInt(p[2]), decode(p[3]), decode(p[4]), decode(p[5]),
                        p[6], p[7], p[8]);
                    appointments.add(a);
                    nextId = Math.max(nextId, a.id + 1);
                } catch (RuntimeException ignored) { }
            }
        } catch (IOException ex) {
            message("Could not read appointments.txt: " + ex.getMessage(),
                "File Error", JOptionPane.ERROR_MESSAGE);
        }
    }

    private boolean saveAppointments() {
        try (PrintWriter out = new PrintWriter(new FileWriter(DATA_FILE))) {
            for (Appointment a : appointments) {
                out.println(a.id + "\t" + encode(a.patient) + "\t" + a.age + "\t"
                    + encode(a.phone) + "\t" + encode(a.problem) + "\t" + encode(a.doctor)
                    + "\t" + a.date + "\t" + a.time + "\t" + a.status);
            }
            return true;
        } catch (IOException ex) {
            message("Could not save appointments.txt: " + ex.getMessage(),
                "File Error", JOptionPane.ERROR_MESSAGE);
            return false;
        }
    }

    private Appointment findById(int id) {
        for (Appointment a : appointments) if (a.id == id) return a;
        return null;
    }

    private String encode(String s) {
        return s.replace("%", "%25").replace("\t", "%09").replace("\n", "%0A").replace("\r", "%0D");
    }
    private String decode(String s) {
        return s.replace("%0D", "\r").replace("%0A", "\n").replace("%09", "\t").replace("%25", "%");
    }
    private void message(String text, String title, int type) {
        JOptionPane.showMessageDialog(this, text, title, type);
    }

    private static class Appointment {
        int id, age;
        String patient, phone, problem, doctor, date, time, status;
        Appointment(int id, String patient, int age, String phone, String problem,
                    String doctor, String date, String time, String status) {
            this.id = id; this.patient = patient; this.age = age; this.phone = phone;
            this.problem = problem; this.doctor = doctor; this.date = date;
            this.time = time; this.status = status;
        }
    }

    public static void main(String[] args) {
        SwingUtilities.invokeLater(() -> new DoctorAppointmentBookingSystem().setVisible(true));
    }
}
